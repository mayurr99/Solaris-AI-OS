# Copy to secrets.env, fill in, then:  supabase secrets set --env-file supabase/secrets.env
# Never share this file or put it in the dashboard.

# Sarvam (Sarvam dashboard → API keys; IDs from your workspace / agent / phone connection)
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_NUMBER=+91XXXXXXXXXX

# A long random secret you invent (letters+digits, 32+ chars). Used in every webhook URL.
WEBHOOK_TOKEN=
# Where Sarvam should report instant (dashboard-started) calls:
PUBLIC_WEBHOOK_URL=https://<PROJECT_REF>.supabase.co/functions/v1/sarvam-webhook?token=<WEBHOOK_TOKEN>

# Your hosted dashboard address (after Netlify), e.g. https://solaris-ai-os.netlify.app
ALLOWED_ORIGIN=*

# Optional limits (the dashboard Settings page can also set them)
DAILY_CALL_CAP=300
MAX_ATTEMPTS=3
RETRY_GAP_HOURS=4
BATCH_SIZE=5
